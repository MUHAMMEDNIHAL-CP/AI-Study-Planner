GEMINI_API_KEY=replace_with_your_google_ai_studio_key
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MODELS=gemini-3.5-flash,gemini-3.1-flash-lite
FRONTEND_URL=http://localhost:5173

# Database (leave unset to use the default SQLite file db.sqlite3).
DATABASE_URL=postgres://USER:PASSWORD@localhost:5432/DBNAME

# Session lifetimes (JWT).
# Access token is short-lived; the refresh token keeps students logged in.
JWT_ACCESS_MINUTES=30
JWT_REFRESH_DAYS=30

# Google sign-in: OAuth Client ID (Web application) from Google Cloud Console.
# https://console.cloud.google.com/apis/credentials
GOOGLE_OAUTH_CLIENT_ID=xxxx.apps.googleusercontent.com

# Apple sign-in: Services ID enabled with "Sign in with Apple" (paid Apple Developer account).
# https://developer.apple.com/account/resources/identifiers/list/servicesId
APPLE_CLIENT_ID=com.example.flox.signin
